NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# MongoDB must support transactions (replica set or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/express_api?replicaSet=rs0
# Create indexes explicitly with yarn db:indexes; enable automatic creation only for local development.
MONGODB_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
MONGODB_MAX_IDLE_TIME_MS=60000
REDIS_URI=redis://127.0.0.1:6379

# Generate a random secret of at least 32 characters before starting the API.
JWT_SECRET=
# A positive duration; parsed into whole seconds before signing JWTs.
JWT_EXPIRATION=24h
JWT_ISSUER=express-mongodb-api
JWT_AUDIENCE=express-mongodb-client
BCRYPT_ROUNDS=12

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
# Require STARTTLS for production submission when implicit TLS is not used.
MAIL_REQUIRE_TLS=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="API <no-reply@example.com>"
MAIL_DEFAULT_LANGUAGE=en
# Required: generate once with `openssl rand -hex 32`; use the same secret in API and mail workers.
# Keep this key stable across deployments while encrypted jobs/idempotency records exist.
MAIL_QUEUE_ENCRYPTION_KEY=
# Use a domain you control for stable retry Message-IDs.
MAIL_MESSAGE_ID_DOMAIN=notifications.local
MAIL_QUEUE_MAX_ATTEMPTS=8
MAIL_QUEUE_MAX_AGE_MS=86400000
MAIL_QUEUE_RETENTION_MS=604800000
MAIL_WORKER_HEARTBEAT_MS=10000
MAIL_WORKER_STALE_MS=45000
MAIL_WORKER_CONCURRENCY=2
MAIL_WORKER_POLL_MS=1000
MAIL_WORKER_LEASE_MS=60000
MAIL_WORKER_SHUTDOWN_TIMEOUT_MS=60000
MAIL_RETRY_BASE_DELAY_MS=30000
MAIL_RETRY_MAX_DELAY_MS=3600000
# Optional custom template directory, relative to the project root.
# MAIL_TPL_PATH=src/domains/notifications/templates

# Storage is independent of dist/ and is never removed by the build.
STORAGE_PATH=storage/public
STORAGE_URL=/storage/public
MAX_UPLOAD_BYTES=10485760

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Comma-separated trusted proxy IPs/CIDRs; leave empty when directly exposed.
TRUST_PROXY=
LOG_LEVEL=info
# API_LOG_FILENAME=api-logs.log
SHUTDOWN_TIMEOUT_MS=10000

# Swagger is explicit opt-in. Interactive API execution is separately opt-in.
DOCS_ENABLED=true
DOCS_TRY_IT_OUT_ENABLED=false
# Enabled production docs require dedicated credentials (password: at least 32 characters).
# DOCS_USERNAME=docs
# DOCS_PASSWORD_FILE=/run/secrets/docs_password

# Independent account and recipient budgets; existing IP limits still apply.
ACCOUNT_RATE_LIMIT_MAX=20
MAIL_RECIPIENT_DAILY_LIMIT=50
MAIL_TEMPLATE_DAILY_LIMIT=10
MAIL_SECURITY_COOLDOWN_MS=60000
# Quota includes original files, active upload reservations, and conversion capacity.
MEDIA_MAX_FILES=20
MEDIA_MAX_TOTAL_BYTES=104857600
MEDIA_UNUSED_RETENTION_MS=86400000
