NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=https://api.example.com
CLIENT_URL=https://app.example.com
MONGODB_URI_FILE=/run/secrets/mongodb_uri
MONGODB_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=20
REDIS_URI_FILE=/run/secrets/redis_uri
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_EXPIRATION=24h
JWT_ISSUER=express-mongodb-api
JWT_AUDIENCE=express-mongodb-client
BCRYPT_ROUNDS=12
MAIL_QUEUE_ENCRYPTION_KEY_FILE=/run/secrets/mail_queue_key
MAIL_DEFAULT_LANGUAGE=en
STORAGE_PATH=/app/storage/public
STORAGE_URL=/storage/public
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Configure exact trusted reverse-proxy addresses/CIDRs before serving through a proxy.
TRUST_PROXY=
DOCS_ENABLED=false
DOCS_TRY_IT_OUT_ENABLED=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Independent account and recipient budgets; existing IP limits still apply.
ACCOUNT_RATE_LIMIT_MAX=20
MAIL_RECIPIENT_DAILY_LIMIT=50
MAIL_TEMPLATE_DAILY_LIMIT=10
MAIL_SECURITY_COOLDOWN_MS=60000
# Quota includes original files, active upload reservations, and conversion capacity.
MEDIA_MAX_FILES=20
MEDIA_MAX_TOTAL_BYTES=104857600
MEDIA_UNUSED_RETENTION_MS=86400000
