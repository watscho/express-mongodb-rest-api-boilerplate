NODE_ENV=production
CLIENT_URL=https://app.example.com
MONGODB_URI_FILE=/run/secrets/mongodb_uri
MONGODB_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=10
MAIL_QUEUE_ENCRYPTION_KEY_FILE=/run/secrets/mail_queue_key
MAIL_DEFAULT_LANGUAGE=en
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_USER=replace-with-smtp-username
MAIL_PASSWORD_FILE=/run/secrets/smtp_password
MAIL_FROM="Application <no-reply@example.com>"
MAIL_MESSAGE_ID_DOMAIN=example.com
MAIL_WORKER_CONCURRENCY=2
MAIL_WORKER_POLL_MS=1000
MAIL_WORKER_LEASE_MS=60000
MAIL_WORKER_SHUTDOWN_TIMEOUT_MS=60000
MAIL_WORKER_HEARTBEAT_MS=10000
MAIL_WORKER_STALE_MS=45000
MAIL_RETRY_BASE_DELAY_MS=30000
MAIL_RETRY_MAX_DELAY_MS=3600000
LOG_LEVEL=info
