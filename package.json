{
  "name": "express-mongodb-rest-api-boilerplate",
  "version": "2.0.0",
  "private": true,
  "description": "Domain-based Express REST API with TypeScript, MongoDB, Redis, JWT, Zod DTOs, OpenAPI/Swagger, and transactional background email delivery.",
  "license": "MIT",
  "author": "Vacho Aivazov",
  "homepage": "https://github.com/watscho/express-mongodb-rest-api-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watscho/express-mongodb-rest-api-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/watscho/express-mongodb-rest-api-boilerplate/issues"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "rest-api",
    "mongodb",
    "mongoose",
    "redis",
    "jwt",
    "authentication",
    "domain-based",
    "dto",
    "zod",
    "email-templates",
    "i18n",
    "boilerplate",
    "background-jobs",
    "transactional-outbox",
    "openapi",
    "swagger",
    "docker"
  ],
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:mail": "tsx watch src/app/runtime/mail/worker.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "start:mail": "node --enable-source-maps dist/app/runtime/mail/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:legacy": "tsx scripts/migrateLegacy.ts",
    "db:indexes": "tsx scripts/createIndexes.ts",
    "docs:export": "tsx scripts/exportOpenApi.ts",
    "docs:export:prod": "node --enable-source-maps dist/app/runtime/commands/openapi.js",
    "mail:queue": "tsx src/app/runtime/commands/mail.ts",
    "mail:queue:prod": "node --enable-source-maps dist/app/runtime/commands/mail.js",
    "db:indexes:prod": "node --enable-source-maps dist/app/runtime/commands/database/indexes.js",
    "db:migrate:legacy:prod": "node --enable-source-maps dist/app/runtime/commands/database/migrate.js",
    "test": "yarn build && node --experimental-test-module-mocks --import ./src/__tests__/setup.mjs --test --test-timeout=30000 'src/**/__tests__/*.test.mjs'",
    "test:coverage": "yarn build && node scripts/coverage.mjs"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "i18next": "26.5.12",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1",
    "sharp": "0.35.5",
    "swagger-ui-dist": "5.34.1",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "openapi-types": "12.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "resolutions": {
    "@types/express": "5.0.6"
  },
  "scarfSettings": {
    "enabled": false
  }
}
