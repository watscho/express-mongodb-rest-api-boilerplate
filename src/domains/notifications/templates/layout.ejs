<!doctype html>
<html lang="<%= language %>" dir="<%= direction %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title><%= t('title') %></title>
  </head>
  <body style="margin: 0; padding: 0; width: 100%; background-color: #f6f7f9; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%;">
    <div aria-hidden="true" style="display: none !important; visibility: hidden; max-height: 0; max-width: 0; overflow: hidden; opacity: 0; font-size: 1px; line-height: 1px; mso-hide: all;"><%= typeof preheader === 'string' ? preheader : t('body') %></div>
    <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f6f7f9" style="border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <!--[if mso]>
          <table role="presentation" width="600" border="0" cellpadding="0" cellspacing="0"><tr><td>
          <![endif]-->
          <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="width: 100%; max-width: 600px; border: 1px solid #e2e8f0; border-radius: 8px; border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">
            <tr>
              <td align="<%= direction === 'rtl' ? 'right' : 'left' %>" style="padding: 32px 24px;">
                <h1 style="margin: 0 0 24px; font-family: Arial, Helvetica, sans-serif; font-size: 26px; font-weight: 700; line-height: 1.3; color: #111827;"><%= t('title') %></h1>
                <% if (typeof content === 'string') { %>
                <%- content %>
                <% } else { %>
                <p style="margin: 0 0 20px; font-size: 16px; line-height: 1.6; color: #374151;"><%= t('body') %></p>
                <% if (actionUrl) { %>
                <%- include('./partials/action-link.ejs') %>
                <% } %>
                <% } %>
              </td>
            </tr>
            <tr>
              <td align="<%= direction === 'rtl' ? 'right' : 'left' %>" style="padding: 20px 24px; border-top: 1px solid #e2e8f0; font-size: 13px; line-height: 1.5; color: #64748b;">
                <%= t('footerLabel') %> <a href="https://github.com/watscho" target="_blank" rel="noopener noreferrer" style="color: #475569; text-decoration: underline;">vacho</a>.
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
