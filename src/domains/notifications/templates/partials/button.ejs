<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 24px 0; border-collapse: separate; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">
  <tr>
    <td align="center" bgcolor="#2563eb" style="border-radius: 6px; mso-padding-alt: 14px 22px;">
      <a href="<%= url %>" target="_blank" rel="noopener noreferrer" style="display: inline-block; padding: 14px 22px; border: 1px solid #2563eb; border-radius: 6px; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 700; line-height: 1.3; color: #ffffff; text-align: center; text-decoration: none;"><%= label %></a>
    </td>
  </tr>
</table>
